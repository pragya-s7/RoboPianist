<mujoco model="chord_v5_final_stable">
    <include file="piano.xml"/>
    
    <!-- STABILITY CORE:
         - implicitfast: The only integrator that handles stiff robot joints without exploding.
         - timestep="0.002": Standard 500Hz simulation.
    -->
    <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

    <visual>
        <global offwidth="1920" offheight="1080"/>
        <headlight active="1"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <quality shadowsize="4096"/>
    </visual>

    <default>
        <!-- MASTER DEFAULT -->
        <default class="robot_part">
            <geom material="mat_robot"/> 
            <!-- High damping = Molasses. Stops vibration. -->
            <joint damping="10.0" armature="2.0" frictionloss="1.0"/>
        </default>

        <!-- ARM: Ghost Mode (No collisions) -->
        <default class="arm">
            <geom rgba="0.8 0.8 0.8 1" type="capsule" size="0.035" contype="0" conaffinity="0"/>
        </default>
        
        <!-- WRIST: Ghost Mode -->
        <default class="wrist">
            <geom rgba="0.3 0.3 0.3 1" type="capsule" size="0.025" contype="0" conaffinity="0"/>
            <joint damping="2.0" armature="0.5"/>
        </default>
        
        <!-- FINGER: Ghost Mode -->
        <default class="finger">
            <geom rgba="0.9 0.9 0.9 1" type="capsule" size="0.009" contype="0" conaffinity="0"/>
            <joint damping="0.1" armature="0.05" limited="true" range="-0.1 1.6"/>
        </default>
        
        <!-- FINGERTIP: Solid Collider -->
        <default class="fingertip">
            <geom rgba="1 0.2 0.2 1" type="sphere" size="0.009" 
                  contype="1" conaffinity="1" 
                  friction="1.5 0.005 0.0001" solimp="0.9 0.95 0.001" solref="0.005 1"/>
            <site type="sphere" size="0.01" rgba="0 1 0 0.5"/>
        </default>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
        <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
        <material name="mat_robot" specular="1" shininess="1" rgba="0.8 0.8 0.8 1"/>
    </asset>

    <worldbody>
        <light pos="0 0 2" dir="0 0 -1" castshadow="true" diffuse="0.8 0.8 0.8"/>
        <!-- Floor moved down to prevent spawn explosions -->
        <geom name="floor" pos="0 0 -1.0" size="2 2 0.1" type="plane" material="matplane"/>
        
        <body name="debug_target" pos="0 0 0" mocap="true">
            <geom type="sphere" size="0.02" rgba="0 1 1 0.8"/>
        </body>

        <!-- ROBOT BASE -->
        <body name="base" pos="0.63 -0.6 0">
            <geom type="cylinder" size="0.12 0.15" rgba="0.1 0.1 0.1 1" pos="0 0 0.075"/>
            
            <!-- Link 1: Waist (Z-Axis Pan) -->
            <body name="link1" pos="0 0 0.15">
                <joint name="j1" axis="0 0 1" range="-2.5 2.5" class="robot_part"/>
                <geom fromto="0 0 0 0 0 0.1" class="arm"/>
                
                <!-- Link 2: Shoulder (Y-Axis Pitch - Bends Forward) -->
                <body name="link2" pos="0 0 0.1">
                    <joint name="j2" axis="0 1 0" range="-1.5 1.5" class="robot_part"/>
                    <geom fromto="0 0 0 0 0 0.4" class="arm"/> 
                    
                    <!-- Link 3: Elbow (Y-Axis Pitch - Bends Forward) -->
                    <!-- FIX: Axis is now 0 1 0. This creates a standard "reach forward" arm. -->
                    <body name="link3" pos="0 0 0.4">
                        <joint name="j3" axis="0 1 0" range="-2.5 0.5" class="robot_part"/>
                        <geom fromto="0 0 0 0 0.35 0" class="arm"/> 

                        <!-- Link 4: Forearm (Y-Axis Twist) -->
                        <body name="link4" pos="0 0.35 0">
                            <!-- This allows the hand to rotate to be flat -->
                            <joint name="j4" axis="0 1 0" range="-3.0 3.0" class="robot_part"/>
                            <geom fromto="0 0 0 0 0.15 0" class="arm" size="0.03"/>

                            <!-- Link 5: Wrist Pitch (X-Axis) -->
                            <body name="wrist_pitch" pos="0 0.15 0">
                                <joint name="j5" axis="1 0 0" range="-1.5 1.5" class="wrist"/>
                                <geom fromto="0 0 0 0 0.04 0" class="wrist"/>

                                <!-- Link 6: Wrist Yaw (Z-Axis) -->
                                <body name="wrist_yaw" pos="0 0.04 0">
                                    <joint name="j6" axis="0 0 1" range="-0.5 0.5" class="wrist"/>
                                    <geom fromto="0 0 0 0 0.04 0" class="wrist"/>
                                    
                                    <!-- PALM -->
                                    <body name="palm" pos="0 0.04 0" euler="-1.57 0 0">
                                        <geom type="box" size="0.045 0.01 0.045" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
                                        
                                        <!-- THUMB -->
                                        <body name="thumb_base" pos="-0.05 -0.01 0.02" euler="0.5 0.8 0">
                                            <joint name="jf1_abduction" axis="0 0 1" range="-0.5 0.5" class="finger"/>
                                            <geom fromto="0 0 0 0.03 0 0" class="finger"/>
                                            <body name="thumb_prox" pos="0.03 0 0">
                                                <joint name="jf1" axis="0 1 0" range="-0.2 1.0" class="finger"/>
                                                <geom fromto="0 0 0 0.03 0 0" class="finger"/>
                                                <body name="thumb_dist" pos="0.03 0 0">
                                                    <joint name="jf1_dist" axis="0 1 0" range="-0.2 1.2" class="finger"/>
                                                    <geom fromto="0 0 0 0.025 0 0" class="finger"/>
                                                    <body name="t1" pos="0.025 0 0">
                                                        <geom class="fingertip"/>
                                                        <site name="tip_1" pos="0 0 0"/>
                                                    </body>
                                                </body>
                                            </body>
                                        </body>

                                        <!-- FINGERS -->
                                        <body name="f2_prox" pos="-0.028 0 0.05" euler="0 0 0">
                                            <joint name="jf2" axis="1 0 0" class="finger"/>
                                            <geom fromto="0 0 0 0 0 0.04" class="finger"/>
                                            <body name="f2_mid" pos="0 0 0.04">
                                                <joint name="jf2_mid" axis="1 0 0" class="finger"/>
                                                <geom fromto="0 0 0 0 0 0.03" class="finger"/>
                                                <body name="t2" pos="0 0 0.03">
                                                    <geom class="fingertip"/>
                                                    <site name="tip_2" pos="0 0 0"/>
                                                </body>
                                            </body>
                                        </body>

                                        <body name="f3_prox" pos="0 0 0.055" euler="0 0 0">
                                            <joint name="jf3" axis="1 0 0" class="finger"/>
                                            <geom fromto="0 0 0 0 0 0.045" class="finger"/>
                                            <body name="f3_mid" pos="0 0 0.045">
                                                <joint name="jf3_mid" axis="1 0 0" class="finger"/>
                                                <geom fromto="0 0 0 0 0 0.035" class="finger"/>
                                                <body name="t3" pos="0 0 0.035">
                                                    <geom class="fingertip"/>
                                                    <site name="tip_3" pos="0 0 0"/>
                                                </body>
                                            </body>
                                        </body>

                                        <body name="f4_prox" pos="0.028 0 0.05" euler="0 0 0">
                                            <joint name="jf4" axis="1 0 0" class="finger"/>
                                            <geom fromto="0 0 0 0 0 0.04" class="finger"/>
                                            <body name="f4_mid" pos="0 0 0.04">
                                                <joint name="jf4_mid" axis="1 0 0" class="finger"/>
                                                <geom fromto="0 0 0 0 0 0.03" class="finger"/>
                                                <body name="t4" pos="0 0 0.03">
                                                    <geom class="fingertip"/>
                                                    <site name="tip_4" pos="0 0 0"/>
                                                </body>
                                            </body>
                                        </body>

                                        <body name="f5_prox" pos="0.054 0 0.045" euler="0 0 0">
                                            <joint name="jf5" axis="1 0 0" class="finger"/>
                                            <geom fromto="0 0 0 0 0 0.03" class="finger"/>
                                            <body name="f5_mid" pos="0 0 0.03">
                                                <joint name="jf5_mid" axis="1 0 0" class="finger"/>
                                                <geom fromto="0 0 0 0 0 0.025" class="finger"/>
                                                <body name="t5" pos="0 0 0.025">
                                                    <geom class="fingertip"/>
                                                    <site name="tip_5" pos="0 0 0"/>
                                                </body>
                                            </body>
                                        </body>

                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>
    
    <actuator>
        <!-- POSITION ACTUATORS: Act like virtual springs. Stable with implicitfast. -->
        <!-- KP=50 is soft enough to not explode, stiff enough to hold up the arm -->
        <position name="p1" joint="j1" kp="50" ctrllimited="true" ctrlrange="-2.5 2.5"/>
        <position name="p2" joint="j2" kp="50" ctrllimited="true" ctrlrange="-1.5 1.5"/>
        <position name="p3" joint="j3" kp="50" ctrllimited="true" ctrlrange="-2.5 0.5"/>
        <position name="p4" joint="j4" kp="50" ctrllimited="true" ctrlrange="-3.0 3.0"/>
        
        <position name="p5" joint="j5" kp="20" ctrllimited="true" ctrlrange="-1.5 1.5"/>
        <position name="p6" joint="j6" kp="20" ctrllimited="true" ctrlrange="-0.5 0.5"/>
        
        <!-- Fingers -->
        <position name="pf1" joint="jf1" kp="5" ctrllimited="true" ctrlrange="-0.2 1.0"/>
        <position name="pf1d" joint="jf1_dist" kp="5" ctrllimited="true" ctrlrange="-0.2 1.2"/>
        <position name="pf2" joint="jf2" kp="5" ctrllimited="true" ctrlrange="-0.2 1.6"/>
        <position name="pf2m" joint="jf2_mid" kp="5" ctrllimited="true" ctrlrange="0 1.6"/>
        <position name="pf3" joint="jf3" kp="5" ctrllimited="true" ctrlrange="-0.2 1.6"/>
        <position name="pf3m" joint="jf3_mid" kp="5" ctrllimited="true" ctrlrange="0 1.6"/>
        <position name="pf4" joint="jf4" kp="5" ctrllimited="true" ctrlrange="-0.2 1.6"/>
        <position name="pf4m" joint="jf4_mid" kp="5" ctrllimited="true" ctrlrange="0 1.6"/>
        <position name="pf5" joint="jf5" kp="5" ctrllimited="true" ctrlrange="-0.2 1.6"/>
        <position name="pf5m" joint="jf5_mid" kp="5" ctrllimited="true" ctrlrange="0 1.6"/>
    </actuator>
</mujoco>
